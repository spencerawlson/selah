# Copy to apps/mobile/.env
#
#   cp .env.example .env
#
# Only EXPO_PUBLIC_* variables reach the app bundle. They are embedded in the
# JavaScript at build time, so treat every value here as public — never put an
# API key or secret in this file.

# Where the backend lives.
#
# Leave it unset and the app guesses: localhost on iOS/web, 10.0.2.2 on the
# Android emulator (which is how the emulator reaches your host machine).
#
# Set it explicitly when you are on a physical device — use your computer's LAN
# address, since the phone cannot see your localhost:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
#
# EXPO_PUBLIC_API_URL=http://localhost:8000

# "Continue with Google" (expo-auth-session — web, iOS and Android).
# Create OAuth 2.0 client IDs at https://console.cloud.google.com/apis/credentials.
# Client IDs are public (not secrets). The button shows a setup note until at
# least the platform's client id below is set.
#
# Web  (also used by Expo Go). The SAME value as the backend's GOOGLE_CLIENT_ID.
#   Web application client. Add http://localhost:8081 to BOTH "Authorized
#   JavaScript origins" and "Authorized redirect URIs".
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
#
# Native standalone builds (optional until you ship to the stores):
#   iOS client     — bundle id com.<you>.selah, scheme selah://
#   Android client — package com.<you>.selah + your signing SHA-1
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
