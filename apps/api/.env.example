# Copy to apps/api/.env for running uvicorn directly on the host.
#
#   cp .env.example .env
#
# Every setting here maps to a field on `Settings` in app/core/config.py.
# Anything you leave out falls back to the default declared there.

# ---- App ------------------------------------------------------------------
APP_NAME=Selah API
ENVIRONMENT=local          # local | staging | production
DEBUG=true

# ---- Database -------------------------------------------------------------
# Default: a local SQLite file, so the API runs with no Docker and no setup.
DATABASE_URL=sqlite+aiosqlite:///./selah.db
#
# Postgres + pgvector (after `docker compose up -d db`). Semantic search and
# the verse_embeddings table only exist on this driver.
# DATABASE_URL=postgresql+psycopg://selah:selah@localhost:5432/selah
#
DB_ECHO=false              # true logs every SQL statement

# ---- Auth -----------------------------------------------------------------
AUTH_PROVIDER=local        # local | firebase | supabase
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-replace-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=10080

# ---- AI -------------------------------------------------------------------
# mock   — offline, deterministic, no key, no spend. The default.
# openai — any OpenAI-compatible /chat/completions endpoint.
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
#
# Other providers that work unchanged — set AI_BASE_URL and AI_MODEL:
#   Ollama     http://localhost:11434/v1          (AI_API_KEY can be anything)
#   LM Studio  http://localhost:1234/v1
#   Together   https://api.together.xyz/v1
#   Groq       https://api.groq.com/openai/v1

# ---- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
