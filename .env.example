# Copy to .env — Docker Compose reads this file automatically.
#
#   cp .env.example .env
#
# These values configure the containers. The API also reads apps/api/.env when
# you run uvicorn directly on the host.

# ---- Postgres -------------------------------------------------------------
POSTGRES_USER=selah
POSTGRES_PASSWORD=selah
POSTGRES_DB=selah
POSTGRES_PORT=5432

# ---- API container --------------------------------------------------------
API_PORT=8000
ENVIRONMENT=local
DEBUG=true

# Generate a real one before deploying anywhere:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-replace-before-deploying

# ---- AI -------------------------------------------------------------------
# "mock" needs no key and returns curated explanations for the seeded verses.
# Switch to "openai" and set AI_API_KEY when you want real generation.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---- CORS -----------------------------------------------------------------
# Expo dev server (8081) and the legacy web port (19006).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
